# Copy this file to .env and fill in your own values.
# Vite only exposes variables that start with VITE_.
# Do not commit .env. Never put secret keys in source code.
# The Supabase anon key is safe to use in the browser only because Row Level Security is enabled.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://127.0.0.1:8000
